# ============================================
# voicekey .gitignore
# ============================================

# ------------------------------------------
# Python関連
# ------------------------------------------
# バイトコード・キャッシュ
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# 仮想環境
venv/
env/
ENV/

# ------------------------------------------
# 環境変数・機密情報
# ------------------------------------------
# APIキーなどの機密情報を含むファイル
.env
benchmark/.env

# 配布ビルド用のキー（git にコミット絶対禁止・ビルド時にローカルから生成）
.env.dist
src/config/embedded_keys.py
macos/Sources/Voicekey/Config/EmbeddedKeys.generated.swift

# ------------------------------------------
# ベンチマーク生成物
# ------------------------------------------
# say で生成する音声と実行結果（音声は再生成可能、結果は実行ごと）
benchmark/audio/*.wav
benchmark/audio/*.aiff
benchmark/results/
benchmark/.venv/

# ------------------------------------------
# Whisperモデル
# ------------------------------------------
# 自動ダウンロードされる大容量ファイル
*.pt

# ------------------------------------------
# 音声ファイル
# ------------------------------------------
# samplesディレクトリ内の音声ファイル（容量が大きいため）
samples/*.mp3
samples/*.wav
samples/*.m4a
samples/*.mp4
samples/*.flac
samples/*.ogg
samples/*.wma

# samplesディレクトリ自体は保持
!samples/.gitkeep

# ------------------------------------------
# IDE・エディタ
# ------------------------------------------
.vscode/
.idea/
*.swp
*.swo

# ------------------------------------------
# OS生成ファイル
# ------------------------------------------
.DS_Store
Thumbs.db

# ------------------------------------------
# ビルド成果物 (PyInstaller)
# ------------------------------------------
# ルート直下のみ（scripts/build/ はビルドスクリプト置き場なので除外しない）
/build/
dist/
*.spec
# メインのspecファイルは保持
!voicekey.spec
!voicekey_debug.spec

# ------------------------------------------
# ログファイル
# ------------------------------------------
*_log.txt
dev_timing.log

# ------------------------------------------
# ユーザー固有設定
# ------------------------------------------
# ユーザーの設定ファイル（.env.exampleを参照）
settings.yaml

# ------------------------------------------
# AI/開発ツール
# ------------------------------------------
.claude/
